});

/* ======================= pointer: drag, pan, zoom ======================= */
const svgPoint = ev => new DOMPoint(ev.clientX, ev.clientY).matrixTransform(svg.getScreenCTM().inverse());
let drag = null;
svg.addEventListener('pointerdown', ev => {
  if (ev.button !== 0) return;
  const nodeEl = ev.target.closest('.node'), edgeEl = ev.target.closest('.edge, .elabel');
  const p = svgPoint(ev);
  if (nodeEl) { const n = NODE[nodeEl.dataset.id]; drag = { kind: 'node', n, dx: p.x - n.x, dy: p.y - n.y, sx: ev.clientX, sy: ev.clientY, moved: false }; }
  else if (edgeEl) drag = { kind: 'edge', id: edgeEl.dataset.id, sx: ev.clientX, sy: ev.clientY, moved: false };
  else { drag = { kind: 'pan', sx: ev.clientX, sy: ev.clientY, vb: { ...VB }, k: 1 / svg.getScreenCTM().a, moved: false }; }
  svg.setPointerCapture(ev.pointerId);
});
svg.addEventListener('pointermove', ev => {
  if (!drag) {
    const nodeEl = ev.target.closest && ev.target.closest('.node');
    const id = nodeEl ? nodeEl.dataset.id : null;
    if (id !== state.hover) { state.hover = id; if (!state.sel) applyHighlight(); }
    return;
  }
  if (!drag.moved && Math.hypot(ev.clientX - drag.sx, ev.clientY - drag.sy) > 4) { drag.moved = true; if (drag.kind === 'pan') svg.classList.add('panning'); }
  if (!drag.moved) return;
  if (drag.kind === 'node') { const p = svgPoint(ev); drag.n.x = p.x - drag.dx; drag.n.y = p.y - drag.dy; scheduleLayout(); }
  else if (drag.kind === 'pan') { VB.x = drag.vb.x - (ev.clientX - drag.sx) * drag.k; VB.y = drag.vb.y - (ev.clientY - drag.sy) * drag.k; setVB(); }
});
svg.addEventListener('pointerup', () => {
  if (!drag) return;
  const d = drag; drag = null; svg.classList.remove('panning');
  if (d.moved) return;
  if (d.kind === 'node') select({ kind: 'node', id: d.n.id });
  else if (d.kind === 'edge') select({ kind: 'edge', id: d.id });
  else select(null);
});
svg.addEventListener('pointerleave', () => { if (!drag && state.hover) { state.hover = null; if (!state.sel) applyHighlight(); } });
svg.addEventListener('keydown', ev => {
  const nodeEl = ev.target.closest && ev.target.closest('.node');
  if (nodeEl && (ev.key === 'Enter' || ev.key === ' ')) { ev.preventDefault(); select({ kind: 'node', id: nodeEl.dataset.id }); }
  if (ev.key === 'Escape') select(null);
});
function zoomAt(f, cx, cy) {
  const nw = Math.min(5000, Math.max(450, VB.w * f)), k = nw / VB.w;
  VB.x = cx - (cx - VB.x) * k; VB.y = cy - (cy - VB.y) * k; VB.w = nw; VB.h *= k; setVB();
}
svg.addEventListener('wheel', ev => { ev.preventDefault(); const p = svgPoint(ev); zoomAt(Math.exp(ev.deltaY * 0.0012), p.x, p.y); }, { passive: false });
const center = () => ({ x: VB.x + VB.w / 2, y: VB.y + VB.h / 2 });
document.getElementById('zin').addEventListener('click', () => { const c = center(); zoomAt(1 / 1.25, c.x, c.y); });
document.getElementById('zout').addEventListener('click', () => { const c = center(); zoomAt(1.25, c.x, c.y); });
document.getElementById('zfit').addEventListener('click', fit);
function fit() {
  const bb = gAll.getBBox();
  if (!bb.width) return;
  const pad = 16;
  VB.x = bb.x - pad; VB.y = bb.y - pad; VB.w = bb.width + 2 * pad; VB.h = bb.height + 2 * pad; setVB();
}

