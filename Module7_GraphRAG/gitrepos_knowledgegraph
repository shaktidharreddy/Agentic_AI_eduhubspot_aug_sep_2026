  <h3>Step by step</h3>
  <ol class="steps">
    <li><b>Get read access and inventory the org</b>
      <p>Create a fine-grained, read-only token that is SSO-authorized for the org (see Roadmap → access checklist). List the repos and decide which to index; skip archived and forked repos.</p>
      <script type="text/plain" class="code" data-lang="python" data-title="inventory.py">
import os, requests

ORG = "Cepheid-Data-Platform"
HEADERS = {"Authorization": f"Bearer {os.environ['GITHUB_TOKEN']}",   # read-only, SSO-authorized
           "Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28"}

def gh(path, **params):
    """GET one GitHub REST endpoint and return the parsed JSON."""
    r = requests.get(f"https://api.github.com{path}", headers=HEADERS, params=params, timeout=30)
    r.raise_for_status()
    return r.json()

repos, page = [], 1
while batch := gh(f"/orgs/{ORG}/repos", per_page=100, page=page):
    repos += batch
    page += 1
for r in repos:
    print(r["name"], r["language"], r["size"], r["default_branch"], r["archived"])
</script>
    </li>
    <li><b>Clone, don't fetch file by file</b>
      <p>One clone per repo replaces thousands of per-file API calls. Keep the HEAD SHA: it is the "as of" for every answer and the starting point for incremental updates.</p>
      <script type="text/plain" class="code" data-lang="shell" data-title="PowerShell / bash">
# Git Credential Manager supplies your login - no token in the URL
git clone --filter=blob:none https://github.com/Cepheid-Data-Platform/dp-ingestion.git repos/dp-ingestion
git -C repos/dp-ingestion rev-parse HEAD                      # -> Repository.head_sha
git -C repos/dp-ingestion log --since="12 months ago" --name-status --format="@@%H|%an|%aI|%s"   # -> Commit, MODIFIED
</script>
    </li>
    <li><b>Parse code into symbols</b>
      <p>One pass over each file's syntax tree gives classes, functions (the chunks), imports and raw call sites. Deterministic ids (<code>repo:path::qualified_name</code>) make every load repeatable.</p>
      <script type="text/plain" class="code" data-lang="python" data-title="parse_python.py">
import ast, hashlib

def calls_in(fn):
    """Yield the call expressions inside one function (nested definitions get their own entry)."""
    stack = list(ast.iter_child_nodes(fn))
    while stack:
        node = stack.pop()
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            continue
        if isinstance(node, ast.Call):
            yield node
        stack.extend(ast.iter_child_nodes(node))

def parse_python(repo, path, source):
    """Return the classes, functions, imports and raw call sites of one .py file."""
    tree = ast.parse(source)
    file_id = f"{repo}:{path}"
    module = path.removesuffix(".py").replace("/", ".")
    out = {"classes": [], "functions": [], "imports": [], "calls": []}

    def visit(node, scope, class_id=None):
        for child in ast.iter_child_nodes(node):
            if isinstance(child, ast.ClassDef):
                qname = f"{scope}.{child.name}" if scope else child.name
                cid = f"{file_id}::{qname}"
                out["classes"].append({
                    "id": cid, "name": child.name, "qualified_name": f"{module}.{qname}",
                    "repo": repo, "path": path, "file_id": file_id,
                    "bases": [ast.unparse(b) for b in child.bases],
                    "start_line": child.lineno, "end_line": child.end_lineno,
                    "docstring": ast.get_docstring(child) or ""})
                visit(child, qname, class_id=cid)
            elif isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef)):
                qname = f"{scope}.{child.name}" if scope else child.name
                fid = f"{file_id}::{qname}"
                code = ast.get_source_segment(source, child) or ""
                out["functions"].append({
                    "id": fid, "name": child.name, "qualified_name": f"{module}.{qname}",
                    "repo": repo, "path": path, "file_id": file_id, "class_id": class_id,
                    "signature": f"{child.name}({ast.unparse(child.args)})",
                    "return_type": ast.unparse(child.returns) if child.returns else None,
                    "decorators": [ast.unparse(d) for d in child.decorator_list],
                    "is_async": isinstance(child, ast.AsyncFunctionDef),
                    "is_test": child.name.startswith("test_"),
                    "start_line": child.lineno, "end_line": child.end_lineno,
                    "docstring": ast.get_docstring(child) or "", "code": code,
                    "content_hash": hashlib.sha256(code.encode()).hexdigest()})
                out["calls"] += [{"caller": fid, "callee": ast.unparse(c.func), "line": c.lineno}
                                 for c in calls_in(child)]
                visit(child, qname)                      # nested functions
            elif isinstance(child, ast.Import):
                out["imports"] += [{"file_id": file_id, "module": a.name, "alias": a.asname,
                                    "line": child.lineno} for a in child.names]
            elif isinstance(child, ast.ImportFrom):
                out["imports"].append({"file_id": file_id, "module": child.module or "", "level": child.level,
                                       "names": [a.name for a in child.names], "line": child.lineno})
            else:
                visit(child, scope, class_id)            # if / try / with blocks
    visit(tree, "")
    return out
</script>
    </li>
    <li><b>Find the tables each function reads and writes</b>
      <p>This is the data-platform layer. Spark API calls are found in the syntax tree, and SQL text (in <code>spark.sql()</code> or <code>.sql</code> files) is parsed with sqlglot. Names built at runtime are kept as patterns with <code>dynamic = true</code>.</p>
      <script type="text/plain" class="code" data-lang="python" data-title="tables.py">
import ast
import sqlglot
from sqlglot import exp

WRITE_STATEMENTS = (exp.Insert, exp.Merge, exp.Create, exp.Update, exp.Delete)

def tables_in_sql(sql, dialect="databricks"):
    """Return (tables read, tables written) by a SQL string."""
    reads, writes = set(), set()
    for stmt in sqlglot.parse(sql, read=dialect):
        if stmt is None:
            continue
        ctes = {c.alias_or_name.lower() for c in stmt.find_all(exp.CTE)}
        target = stmt.this.find(exp.Table) if isinstance(stmt, WRITE_STATEMENTS) and stmt.this else None
        for t in stmt.find_all(exp.Table):
            if t.name.lower() in ctes:
                continue
            name = ".".join(p for p in (t.catalog, t.db, t.name) if p).lower()
            (writes if t is target else reads).add(name)
    return reads, writes

SPARK_READ = {"table"}                                    # spark.read.table("x"), spark.table("x")
SPARK_WRITE = {"saveAsTable", "insertInto", "toTable"}    # df.write.saveAsTable("y"), ...

def spark_table_refs(fn_node):
    """Yield (edge, table, line, via, dynamic) for Spark table access inside one function."""
    for call in calls_in(fn_node):
        if not isinstance(call.func, ast.Attribute) or not call.args:
            continue
        method, arg = call.func.attr, call.args[0]
        literal = arg.value if isinstance(arg, ast.Constant) and isinstance(arg.value, str) else None
        if method == "sql" and literal:
            reads, writes = tables_in_sql(literal)
            yield from (("READS", t, call.lineno, "spark.sql", False) for t in reads)
            yield from (("WRITES", t, call.lineno, "spark.sql", False) for t in writes)
        elif method in SPARK_READ | SPARK_WRITE:
            edge = "READS" if method in SPARK_READ else "WRITES"
            name = literal or ast.unparse(arg)            # f-string or variable: keep the pattern
            yield (edge, name.lower(), call.lineno, method, literal is None)
</script>
    </li>
    <li><b>Resolve references, with a confidence on each</b>
      <p>Turn raw call text (<code>self.load</code>, <code>cfg.read_config</code>) into edges between real Function nodes:</p>
      <table class="matrix">
        <tr><th>Call looks like</th><th>Resolved to</th><th><code>resolution</code> / <code>confidence</code></th></tr>
        <tr><td><code>helper()</code> defined in the same file</td><td>That function</td><td>exact · 1.0</td></tr>
        <tr><td><code>self.load()</code></td><td>Method on the same class (or a base class)</td><td>self · 0.95</td></tr>
        <tr><td><code>read_config()</code> after <code>from common.config import read_config</code></td><td>The function in <code>common/config.py</code>, or in another repo through <code>PUBLISHED_FROM</code></td><td>import · 0.9</td></tr>
        <tr><td><code>df.write.saveAsTable()</code>, <code>requests.get()</code></td><td>Library call: no Function edge (handled as a table access or Package use)</td><td>—</td></tr>
        <tr><td>A unique name match elsewhere in the repo</td><td>Best guess</td><td>name-match · 0.4</td></tr>
      </table>
      <p class="small muted">For near-perfect Python resolution later, generate SCIP indexes with <code>scip-python</code> and load their cross-references as <code>resolution = 'exact'</code>.</p>
    </li>
    <li><b>Pull CI and deployment state from the API</b>
      <p>No parsing: CI status is <code>WorkflowRun</code> nodes and deployment status is <code>Deployment</code> nodes, both linked to the <code>Commit</code> they ran on.</p>
      <script type="text/plain" class="code" data-lang="python" data-title="ci_cd.py (uses gh() from step 1)">
def ci_cd_state(org, repo, branch="main"):
    """Newest CI runs on the default branch + deployments per environment, ready to load."""
    runs = gh(f"/repos/{org}/{repo}/actions/runs", branch=branch, per_page=50)["workflow_runs"]
    envs = gh(f"/repos/{org}/{repo}/environments").get("environments", [])
    deployments = []
    for env in envs:
        for d in gh(f"/repos/{org}/{repo}/deployments", environment=env["name"], per_page=10):
            statuses = gh(f"/repos/{org}/{repo}/deployments/{d['id']}/statuses", per_page=1)
            d["state"] = statuses[0]["state"] if statuses else "unknown"      # newest status first
            deployments.append(d)
    run_rows = [{"id": f"run:{r['id']}", "repo": repo, "workflow_github_id": r["workflow_id"],
                 "branch": r["head_branch"], "head_sha": r["head_sha"], "event": r["event"],
                 "status": r["status"], "conclusion": r["conclusion"],
                 "actor": (r.get("actor") or {}).get("login"), "url": r["html_url"],
                 "created_at": r["created_at"]} for r in runs]
    return run_rows, envs, deployments
</script>
    </li>
    <li><b>Load into Neo4j: constraints first, then batched MERGE</b>
      <p>The same <code>run()</code> helper as your course. MERGE on the id makes re-loading harmless, and deleting symbols that disappeared keeps the graph clean. That's the same "upsert + delete orphans" idea as Module 5P.</p>
      <script type="text/plain" class="code" data-lang="python" data-title="load.py">
from kg import run          # run(cypher, **params) from your course

LABELS = ["Repository", "File", "Class", "Function", "Package", "DocChunk", "Table", "Column", "Pipeline", "Task",
          "Workflow", "WorkflowRun", "Environment", "Deployment", "Action", "ConfigKey",
          "Commit", "Person", "Team", "PullRequest", "Ticket", "Subsystem", "Concept"]
for label in LABELS:
    run(f"CREATE CONSTRAINT {label.lower()}_id IF NOT EXISTS FOR (n:{label}) REQUIRE n.id IS UNIQUE")
run("CREATE INDEX function_file IF NOT EXISTS FOR (n:Function) ON (n.file_id)")

def load_functions(rows):
    """Top-level functions. Methods use the same pattern with MATCH (c:Class) + HAS_METHOD."""
    for i in range(0, len(rows), 1000):                   # batches keep transactions small
        run("""
            UNWIND $rows AS row
            MATCH (f:File {id: row.file_id})
            MERGE (fn:Function {id: row.id})
            SET fn += row, fn:Embeddable
            MERGE (f)-[:DEFINES]->(fn)
        """, rows=rows[i:i + 1000])

def drop_vanished(file_id, current_ids):
    """After re-parsing a file, delete functions that no longer exist (edges to the rest survive)."""
    run("""
        MATCH (fn:Function {file_id: $file_id})
        WHERE NOT fn.id IN $ids
        DETACH DELETE fn
    """, file_id=file_id, ids=current_ids)

def load_runs(rows):
    """CI status: one WorkflowRun per run, linked to its Workflow and the Commit it tested."""
    run("""
        UNWIND $rows AS row
        MERGE (r:WorkflowRun {id: row.id})
        SET r += row, r.created_at = datetime(row.created_at)
        WITH r, row
        MATCH (w:Workflow {github_id: row.workflow_github_id})
        MERGE (w)-[:HAS_RUN]->(r)
        WITH r, row
        MATCH (c:Commit {id: row.repo + '@' + row.head_sha})
        MERGE (r)-[:RAN_ON]->(c)
    """, rows=rows)
</script>
    </li>
    <li><b>Enrich: indexes, summaries, embeddings, derived edges</b>
      <p>Summaries go bottom-up (function → file → repo). Embed signature + docstring + summary. Derived edges (table lineage) and communities (Subsystem) are computed inside Neo4j.</p>
      <script type="text/plain" class="code" data-lang="cypher" data-title="indexes_and_lineage.cypher">
// one vector index for every node that carries the extra :Embeddable label
CREATE VECTOR INDEX code_embeddings IF NOT EXISTS
FOR (n:Embeddable) ON (n.embedding)
OPTIONS {indexConfig: {`vector.dimensions`: 1536, `vector.similarity_function`: 'cosine'}};

// exact identifier search - embeddings are poor at matching names like read_config
CREATE FULLTEXT INDEX code_names IF NOT EXISTS
FOR (n:Function|Class|File|Table|Pipeline) ON EACH [n.name, n.qualified_name, n.path, n.id];

// table lineage derived from READS + WRITES (re-run after every ingest)
MATCH (src:Table)<-[:READS]-(fn:Function)-[:WRITES]->(dst:Table)
WHERE src <> dst
WITH src, dst, collect(DISTINCT fn.id) AS via
MERGE (dst)-[d:DERIVED_FROM]->(src)
SET d.via = via, d.computed_at = datetime();
</script>
      <script type="text/plain" class="code" data-lang="python" data-title="summarise.py">
from openai import OpenAI
from kg import embed, run                       # helpers from your course

client = OpenAI()
SUMMARY_MODEL = "<a small chat model your company allows>"
PROMPT = """Explain in 1-3 sentences what this {kind} does, for a data engineer.
Name the tables, systems and side effects it touches. If unsure, say so.

{code}"""

def summarise(kind, code):
    reply = client.chat.completions.create(
        model=SUMMARY_MODEL,
        messages=[{"role": "user", "content": PROMPT.format(kind=kind, code=code[:12000])}])
    return reply.choices[0].message.content.strip()

# only functions that are new or whose code changed since the last run
todo = run("""MATCH (fn:Function) WHERE fn.summary IS NULL OR fn.summarised_hash <> fn.content_hash
              RETURN fn.id AS id, fn.code AS code, fn.signature AS sig, fn.docstring AS doc LIMIT 500""")
for row in todo:
    row["summary"] = summarise("function", row["code"])
vectors = embed([f"{r['sig']}\n{r['doc']}\n{r['summary']}" for r in todo])
run("""UNWIND $rows AS row
       MATCH (fn:Function {id: row.id})
       SET fn.summary = row.summary, fn.embedding = row.vec, fn.summarised_hash = fn.content_hash""",
    rows=[{"id": r["id"], "summary": r["summary"], "vec": v} for r, v in zip(todo, vectors)])
</script>
