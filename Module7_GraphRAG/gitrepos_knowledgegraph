  return `<div class="bars">${rows.map(r => `<div class="bar"><span>${esc(r[labelKey])}</span><span class="track"><span class="fill" ` +
    `style="width:${(100 * r[valueKey] / max).toFixed(1)}%${color ? `;background:${color}` : ''}"></span></span><span class="v">${r[valueKey]}</span></div>`).join('')}</div>`;
}
