    <div class="card"><h4>Environments by tier</h4>${bars(O.environments, 'tier', 'environments', '#dc2626')}
      <p class="small muted" style="margin-top:8px"><code>agent</code> = the <code>copilot</code> environment used by the Copilot coding agent.</p></div>
  </div>

  <h3>Recent deployments</h3>
  <table class="org"><tr><th>Repository</th><th>Environment</th><th>Tier</th><th>State</th><th>When</th><th>Live commit</th></tr>
    ${O.deployments.slice(0, 14).map(d => `<tr><td>${esc(d.repo)}</td><td>${esc(d.environment)}</td><td>${esc(d.tier)}</td><td>${esc(d.state)}</td><td>${esc(d.at)}</td><td><code>${esc(d.sha || '')}</code></td></tr>`).join('')}</table>

