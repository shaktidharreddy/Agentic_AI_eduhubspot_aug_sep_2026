function splitLabel(s) {
  if (s.length <= 10) return [s];
  const parts = s.match(/[A-Z][a-z]*/g) || [s];
  if (parts.length < 2) return [s];
  let best = 1, bestDiff = 1e9;
  for (let i = 1; i < parts.length; i++) {
    const a = parts.slice(0, i).join('').length, b = s.length - a;
    if (Math.abs(a - b) < bestDiff) { bestDiff = Math.abs(a - b); best = i; }
  }
  return [parts.slice(0, best).join(''), parts.slice(best).join('')];
}

NODES.forEach(n => {
  const L = LAYERS[n.layer];
  const g = mk('g', { class: 'node', tabindex: '0', role: 'button', 'data-id': n.id, 'aria-label': `${n.id} node label, ${PHASES[n.phase]}` }, gNodes);
  mk('circle', { class: 'body', r: R, fill: L.fill, stroke: L.stroke }, g);
  const lines = splitLabel(n.id);
  const longest = Math.max(...lines.map(l => l.length));
  const fs = longest <= 8 ? 13 : longest <= 10 ? 12 : 11;
  lines.forEach((ln, i) => {
    const t = mk('text', { class: 'nl', fill: L.ink, 'font-size': fs, y: lines.length === 1 ? 0 : (i === 0 ? -7 : 8) }, g);
    t.textContent = ln;
  });
  n.live = LIVE && LIVE.labels ? (LIVE.labels[n.id] || { count: 0 }) : null;
  if (n.live) {
    if (!n.live.count) g.classList.add('design');
    mk('text', { class: 'ncount', fill: L.ink, y: lines.length === 1 ? 17 : 22 }, g).textContent = n.live.count ? compact(n.live.count) : 'design';
  }
  const b = mk('g', { class: 'badge', transform: `translate(${(R * 0.74).toFixed(1)},${(-R * 0.74).toFixed(1)})` }, g);
  mk('circle', { r: 9, stroke: L.stroke }, b);
  const bt = mk('text', { fill: L.ink }, b); bt.textContent = n.phase;
  mk('title', {}, g).textContent = `${n.id} · ${L.name} · ${PHASES[n.phase]}`;
  n.el = g;
});
EDGES.forEach(e => {
