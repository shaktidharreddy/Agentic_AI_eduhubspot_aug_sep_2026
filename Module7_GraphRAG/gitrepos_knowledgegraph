/* ======================= tabs, static code blocks, copy ======================= */
let currentTab = 'graph';
function showTab(t) {
  if (!document.getElementById('tab-' + t)) t = 'graph';
  currentTab = t;
  document.querySelectorAll('nav.tabs button').forEach(b => b.classList.toggle('active', b.dataset.tab === t));
  document.querySelectorAll('section.tab').forEach(s => s.classList.toggle('active', s.id === 'tab-' + t));
  writeHash();
  window.scrollTo(0, 0);
}
document.querySelectorAll('nav.tabs button').forEach(b => b.addEventListener('click', () => showTab(b.dataset.tab)));
document.querySelectorAll('[data-goto]').forEach(a => a.addEventListener('click', ev => { ev.preventDefault(); showTab(a.dataset.goto); }));
document.querySelectorAll('script.code').forEach(s => {
  s.insertAdjacentHTML('beforebegin', codeBlock(s.textContent, s.dataset.lang, s.dataset.title));
  s.remove();
});
document.getElementById('limGrid').innerHTML = LIMITS.map(([t, imp, why, fix]) =>
  `<div class="lim"><h4>${md(t)}<span class="imp ${imp}">${imp === 'high' ? 'High impact' : imp === 'med' ? 'Medium' : 'Low'}</span></h4><div class="why">${md(why)}</div><div class="fix"><b>Mitigation:</b> ${md(fix)}</div></div>`).join('');
document.addEventListener('click', ev => {
  const b = ev.target.closest('.copy'); if (!b) return;
  const text = b.closest('.codeblock').querySelector('pre').innerText;
  const done = () => { b.textContent = 'Copied'; setTimeout(() => { b.textContent = 'Copy'; }, 1300); };
  const fallback = () => { const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); done(); } finally { ta.remove(); } };
  if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(done, fallback); else fallback();
});

/* ======================= start ======================= */
layout();
fit();
const hp = new URLSearchParams(location.hash.slice(1));
if (hp.get('tab')) showTab(hp.get('tab'));
if (hp.get('node') && NODE[hp.get('node')]) select({ kind: 'node', id: hp.get('node') });
else if (hp.get('rel') && EDGE[hp.get('rel')]) select({ kind: 'edge', id: hp.get('rel') });
else if (hp.get('q') && QMAP[hp.get('q')]) select({ kind: 'q', id: hp.get('q') });
else { applyHighlight(); renderPanel(); }
})();
