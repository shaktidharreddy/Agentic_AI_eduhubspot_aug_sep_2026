/* ======================= helpers ======================= */
const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const md = s => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>');
const NS = 'http://www.w3.org/2000/svg';
function mk(tag, attrs, parent) {
  const n = document.createElementNS(NS, tag);
  for (const k in attrs) n.setAttribute(k, attrs[k]);
  if (parent) parent.appendChild(n);
  return n;
}
const norm = (x, y) => { const L = Math.hypot(x, y) || 1; return { x: x / L, y: y / L }; };
const compact = n => n >= 10000 ? (n / 1000).toFixed(n >= 100000 ? 0 : 1) + 'k' : n.toLocaleString('en-US');
const liveVal = v => typeof v === 'string' ? JSON.stringify(v) : Array.isArray(v) ? '[' + v.map(liveVal).join(', ') + ']' : String(v);

const LANGS = {
  cypher: { re: /(\/\/[^\n]*)|('(?:[^'\\\n]|\\.)*'|"(?:[^"\\\n]|\\.)*")|(\$[A-Za-z_]\w*)|(:[A-Z][A-Za-z_]*)|\b(MATCH|OPTIONAL|WHERE|RETURN|WITH|MERGE|SET|CREATE|CALL|YIELD|UNWIND|AS|ORDER|BY|DESC|ASC|LIMIT|DISTINCT|NOT|EXISTS|AND|OR|IN|IS|NULL|FOR|REQUIRE|UNIQUE|CONSTRAINT|INDEX|IF|ON|EACH|OPTIONS|DETACH|DELETE|CASE|WHEN|THEN|ELSE|END|STARTS|CONTAINS|VECTOR|FULLTEXT|UNION|true|false)\b|\b(count|collect|size|min|max|avg|sum|coalesce|datetime|duration|nodes|relationships|length|toFloat|type|db\.index\.vector\.queryNodes|db\.index\.fulltext\.queryNodes)\b|(\b\d+(?:\.\d+)?\b)/g,
            names: ['c', 's', 'p', 'l', 'k', 'f', 'n'] },
  python: { re: /(#[^\n]*)|("""[\s\S]*?"""|'''[\s\S]*?'''|\b[rfbu]?"(?:[^"\\\n]|\\.)*"|\b[rfbu]?'(?:[^'\\\n]|\\.)*'|"(?:[^"\\\n]|\\.)*"|'(?:[^'\\\n]|\\.)*')|(@[A-Za-z_][\w.]*)|\b(def|return|for|in|if|elif|else|import|from|as|with|class|not|and|or|is|None|True|False|yield|continue|break|lambda|try|except|raise|pass|while|global|del)\b|\b(print|len|range|isinstance|set|list|dict|open|str|int|sorted|any|all|zip|enumerate)\b|(\b\d+(?:\.\d+)?\b)/g,
            names: ['c', 's', 'd', 'k', 'f', 'n'] },
  shell:  { re: /(#[^\n]*)|("(?:[^"\\\n]|\\.)*"|'(?:[^'\\\n]|\\.)*')|\b(git|npx|pip|python|databricks|docker)\b/g, names: ['c', 's', 'k'] },
};
function hl(code, lang) {
  const L = LANGS[lang];
  if (!L) return esc(code);
  let out = '', last = 0, m;
  L.re.lastIndex = 0;
  while ((m = L.re.exec(code))) {
    if (m[0] === '') { L.re.lastIndex++; continue; }
    out += esc(code.slice(last, m.index));
    const g = m.slice(1).findIndex(x => x !== undefined);
    out += `<span class="t-${L.names[g]}">${esc(m[0])}</span>`;
    last = m.index + m[0].length;
  }
  return out + esc(code.slice(last));
}
function codeBlock(code, lang, title) {
  const src = code.replace(/^\n+|\s+$/g, '');
  return `<div class="codeblock"><div class="codehead"><span><span class="lang">${esc(lang)}</span>${title ? esc(title) : ''}</span>` +
         `<button class="copy" type="button">Copy</button></div><pre><code>${hl(src, lang)}</code></pre></div>`;
}
function fmtVal(v) {
  if (v === null) return 'null';
  if (Array.isArray(v)) return '[' + v.map(fmtVal).join(', ') + ']';
  if (typeof v === 'string') return v.startsWith('~') ? v.slice(1) : '"' + v + '"';
  return String(v);
}

