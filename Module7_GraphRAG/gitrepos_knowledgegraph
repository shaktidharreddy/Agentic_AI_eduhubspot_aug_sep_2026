const nodeVisible = n => n.phase <= state.phase && state.layers.has(n.layer);
const edgeVisible = e => e.phase <= state.phase && nodeVisible(NODE[e.from]) && nodeVisible(NODE[e.to]);

function assignLoops() {
  const loops = {};
  EDGES.filter(e => e.from === e.to && edgeVisible(e)).forEach(e => {
    if (e.loopDeg !== undefined) e.loopAngle = e.loopDeg * Math.PI / 180;
    else (loops[e.from] = loops[e.from] || []).push(e);
  });
  Object.entries(loops).forEach(([id, ls]) => {
    const n = NODE[id];
    const angs = [];
    EDGES.forEach(e => {
      if (e.from === e.to || !edgeVisible(e) || (e.from !== id && e.to !== id)) return;
      const o = NODE[e.from === id ? e.to : e.from];
      angs.push(Math.atan2(o.y - n.y, o.x - n.x));
    });
    NODES.forEach(o => {
      if (o === n || !nodeVisible(o) || Math.hypot(o.x - n.x, o.y - n.y) > 260) return;
      angs.push(Math.atan2(o.y - n.y, o.x - n.x));
    });
    angs.sort((a, b) => a - b);
    const gaps = [];
    if (!angs.length) gaps.push({ start: -Math.PI, size: 2 * Math.PI });
    for (let i = 0; i < angs.length; i++) {
      const a1 = angs[i], a2 = i + 1 < angs.length ? angs[i + 1] : angs[0] + 2 * Math.PI;
      gaps.push({ start: a1, size: a2 - a1 });
    }
    gaps.sort((a, b) => b.size - a.size);
    if (ls.length === 1) ls[0].loopAngle = gaps[0].start + gaps[0].size / 2;
    else if (gaps[1] && gaps[1].size > 1.2) { ls[0].loopAngle = gaps[0].start + gaps[0].size / 2; ls[1].loopAngle = gaps[1].start + gaps[1].size / 2; }
    else { ls[0].loopAngle = gaps[0].start + gaps[0].size / 3; ls[1].loopAngle = gaps[0].start + 2 * gaps[0].size / 3; }
  });
}
function updateEdge(e) {
  const a = NODE[e.from], b = NODE[e.to];
  let d, lx, ly;
  if (a === b) {
    const ang = e.loopAngle || -Math.PI / 2, s = 0.42, ext = R + 62;
    const p1 = { x: a.x + R * Math.cos(ang - s), y: a.y + R * Math.sin(ang - s) };
    const p2 = { x: a.x + (R + 2) * Math.cos(ang + s), y: a.y + (R + 2) * Math.sin(ang + s) };
    const c1 = { x: a.x + ext * Math.cos(ang - 0.7), y: a.y + ext * Math.sin(ang - 0.7) };
    const c2 = { x: a.x + ext * Math.cos(ang + 0.7), y: a.y + ext * Math.sin(ang + 0.7) };
    d = `M${p1.x.toFixed(1)},${p1.y.toFixed(1)} C${c1.x.toFixed(1)},${c1.y.toFixed(1)} ${c2.x.toFixed(1)},${c2.y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
    lx = a.x + (R + 58) * Math.cos(ang); ly = a.y + (R + 58) * Math.sin(ang);
  } else {
    const dx = b.x - a.x, dy = b.y - a.y, L = Math.hypot(dx, dy) || 1, lt = e.lt ?? 0.5;
    if (!e.bend) {
      const ux = dx / L, uy = dy / L;
      d = `M${(a.x + ux * R).toFixed(1)},${(a.y + uy * R).toFixed(1)} L${(b.x - ux * (R + 2)).toFixed(1)},${(b.y - uy * (R + 2)).toFixed(1)}`;
      lx = a.x + dx * lt; ly = a.y + dy * lt;
    } else {
      const c = { x: (a.x + b.x) / 2 - dy / L * e.bend, y: (a.y + b.y) / 2 + dx / L * e.bend };
      const sv = norm(c.x - a.x, c.y - a.y), tv = norm(b.x - c.x, b.y - c.y);
      d = `M${(a.x + sv.x * R).toFixed(1)},${(a.y + sv.y * R).toFixed(1)} Q${c.x.toFixed(1)},${c.y.toFixed(1)} ${(b.x - tv.x * (R + 2)).toFixed(1)},${(b.y - tv.y * (R + 2)).toFixed(1)}`;
      lx = (1 - lt) * (1 - lt) * a.x + 2 * (1 - lt) * lt * c.x + lt * lt * b.x;
      ly = (1 - lt) * (1 - lt) * a.y + 2 * (1 - lt) * lt * c.y + lt * lt * b.y;
    }
