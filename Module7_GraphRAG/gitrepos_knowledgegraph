    const ns = NODES.filter(n => n.layer === k && nodeVisible(n));
    if (!ns.length) return;
    const x1 = Math.min(...ns.map(n => n.x)) - R - 22, x2 = Math.max(...ns.map(n => n.x)) + R + 22;
    const y1 = Math.min(...ns.map(n => n.y)) - R - 38, y2 = Math.max(...ns.map(n => n.y)) + R + 16;
    const g = mk('g', { class: 'region' }, gRegions);
