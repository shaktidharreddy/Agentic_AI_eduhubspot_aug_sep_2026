import os
from langchain_openai import ChatOpenAI

# Set your OpenRouter API key and base URL
llm = ChatOpenAI(
    model="openai/gpt-4o",  # Replace with any OpenRouter model identifier
    api_key=os.environ["OPENORUTER_API_KEY"],  # Or set OPENAI_API_KEY / environment variable
    base_url="https://openrouter.ai/api/v1",
)

response = llm.invoke("Hello, who are you?")
print(response.content)


# second method using ChatOpenRouter
from langchain_openrouter import ChatOpenRouter

model = ChatOpenRouter(
    model="anthropic/claude-sonnet-4.5",
    temperature=0,
    max_tokens=1024,
    max_retries=2,
    # other params...
)

messages = [
    (
        "system",
        "You are a helpful assistant that translates English to French. Translate the user sentence.",
    ),
    (    "human", 
        "I love programming."),
]

ai_msg = model.invoke(messages)
ai_msg.content
