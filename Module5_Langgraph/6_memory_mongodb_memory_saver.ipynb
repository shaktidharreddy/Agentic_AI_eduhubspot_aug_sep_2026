from langchain.chat_models import init_chat_model
from typing import Annotated
from typing_extensions import TypedDict
from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import add_messages
from langchain.tools import tool
from langgraph.prebuilt import ToolNode, tools_condition

from dotenv import load_dotenv
load_dotenv()

from pymongo import MongoClient
from langgraph.checkpoint.mongodb import MongoDBSaver

# pip/uv: langgraph-checkpoint-mongodb and pymongo
MONGODB_URI = "mongodb://localhost:27017/"
DB_NAME = "langgraph_checkpoints"

# Keep a long-lived client so later notebook cells can reuse the graph.
# from_conn_string() would close when the `with` block ends.
client = MongoClient(MONGODB_URI)
memory = MongoDBSaver(client, db_name=DB_NAME)

# Indexes are created on first use (checkpoints / checkpoint_writes)
client.admin.command("ping")
print(f"Connected to {MONGODB_URI} db={DB_NAME}")


## Easy MongoDB Compass demo (no LLM)

This cell writes checkpoints to **MongoDB on `mongodb://localhost:27017/`**, database `langgraph_checkpoints`. Look for `thread_id = 'mongodb-demo'` in the `checkpoints` collection.

Re-run it to append more checkpoints to the same thread (that is the persistence proof).


class DemoState(TypedDict):
    visitor: str
    step: int
    note: str

def greet(state: DemoState):
    n = int(state.get("step") or 0) + 1
    return {
        "visitor": "Amit",
        "step": n,
        "note": f"Hello Compass - LangGraph saved turn {n} to MongoDB",
    }

demo_builder = StateGraph(DemoState)
demo_builder.add_node("greet", greet)
demo_builder.add_edge(START, "greet")
demo_builder.add_edge("greet", END)
demo_graph = demo_builder.compile(checkpointer=memory)

mongodb_config = {"configurable": {"thread_id": "mongodb-demo"}}

print("Saving 3 turns to thread_id=mongodb-demo ...")
for _ in range(3):
    print(demo_graph.invoke({}, config=mongodb_config))

rows = list(
    memory.checkpoint_collection.find(
        {"thread_id": "mongodb-demo"},
        {"_id": 0, "thread_id": 1, "checkpoint_id": 1, "metadata": 1},
    ).sort("checkpoint_id", 1)
)

print(f"\n{len(rows)} document(s) in {DB_NAME}.checkpoints for mongodb-demo")
for row in rows:
    print(row)


class State(TypedDict):
    # Messages have the type "list". The `add_messages` function
    # in the annotation defines how this state key should be updated
    # (in this case, it appends messages to the list, rather than overwriting them)
    messages: Annotated[list, add_messages]

@tool
def get_stock_price(symbol: str) -> float:
    '''Return the current price of a stock given the stock symbol
    :param symbol: stock symbol
    :return: current price of the stock
    '''
    return {
        "MSFT": 200.3,
        "AAPL": 100.4,
        "AMZN": 150.0,
        "RIL": 87.6
    }.get(symbol, 0.0)

tools = [get_stock_price]

llm = init_chat_model("google_genai:gemini-2.5-flash")
llm_with_tools = llm.bind_tools(tools)


def chatbot(state: State):
    return {"messages": [llm_with_tools.invoke(state["messages"])]}

builder = StateGraph(State)

builder.add_node(chatbot)
builder.add_node("tools", ToolNode(tools))

builder.add_edge(START, "chatbot")
builder.add_conditional_edges("chatbot", tools_condition)
builder.add_edge("tools", "chatbot")

# Persist graph state to MongoDB on every superstep (thread_id in config)
graph = builder.compile(checkpointer=memory)

from IPython.display import Image, display

display(Image(graph.get_graph().draw_mermaid_png()))

config1 = { 'configurable': { 'thread_id': '1'} }

msg = "I want to buy 20 AMZN stocks using current price. Then 15 MSFT. What will be the total cost?"

state = graph.invoke({"messages": [{"role": "user", "content": msg}]}, config=config1)
print(state["messages"][-1].content)

config2 = { 'configurable': { 'thread_id': '2'} }

msg = "Tell me the current price of 5 AAPL stocks."

state = graph.invoke({"messages": [{"role": "user", "content": msg}]}, config=config2)
print(state["messages"][-1].content)


msg = "Using the current price tell me the total price of 10 RIL stocks and add it to previous total cost"

state = graph.invoke({"messages": [{"role": "user", "content": msg}]}, config=config1)
print(state["messages"][-1].content)


msg = "Tell me the current price of 5 MSFT stocks and add it to previous total"

state = graph.invoke({"messages": [{"role": "user", "content": msg}]}, config=config2)
print(state["messages"][-1].content)


# Inspect the same documents you will see in MongoDB Compass
rows = list(
    memory.checkpoint_collection.find(
        {},
        {"_id": 0, "thread_id": 1, "checkpoint_id": 1, "checkpoint_ns": 1, "metadata": 1},
    ).sort([("thread_id", 1), ("checkpoint_id", 1)])
)

print(f"Found {len(rows)} checkpoint document(s)\n")
for row in rows:
    print(row)

print("\n--- checkpoints for thread_id='1' via MongoDBSaver ---")
for cp in memory.list({"configurable": {"thread_id": "1"}}):
    print(cp.config["configurable"]["checkpoint_id"], cp.metadata)



## How to view this thread in MongoDB Compass

This demo persists to **MongoDB** at **`mongodb://localhost:27017/`**, database **`langgraph_checkpoints`**.

Look for **`thread_id = 'mongodb-demo'`**.

1. Open **MongoDB Compass** and connect to `mongodb://localhost:27017/`.
2. Expand **langgraph_checkpoints**.
3. You should see:
   - `checkpoints` — one document per saved graph superstep (`thread_id` is the conversation id)
   - `checkpoint_writes` — pending writes (`visitor`, `step`, `note` channels)
4. Open **checkpoints** and filter with `{ "thread_id": "mongodb-demo" }`.
5. Refresh if you connected before this notebook ran (collections are created on first `MongoDBSaver` use).

mongosh:

```javascript
use langgraph_checkpoints

db.checkpoints.aggregate([
  { $group: { _id: "$thread_id", n_checkpoints: { $sum: 1 } } },
  { $sort: { _id: 1 } }
])

db.checkpoints.find(
  { thread_id: "mongodb-demo" },
  { thread_id: 1, checkpoint_id: 1, metadata: 1 }
).sort({ checkpoint_id: 1 })

db.checkpoint_writes.find(
  { thread_id: "mongodb-demo" },
  { thread_id: 1, checkpoint_id: 1, channel: 1, type: 1 }
).sort({ checkpoint_id: 1, idx: 1 })
```

`metadata` is the easiest field to read (`step`, `source`). Channel payloads in `checkpoint_writes.value` are serialized (msgpack/binary), not plain chat text.
