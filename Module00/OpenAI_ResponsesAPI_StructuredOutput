from openai import OpenAI
client = OpenAI()

# Passing a list of message dicts directly into 'input'
response = client.responses.create(
    model="gpt-4o",
    input=[
        {"role": "developer", "content": "You are a concise assistant."},
        {"role": "user", "content": "What is the capital of France?"},
        {"role": "assistant", "content": "The capital of France is Paris."},
        {"role": "user", "content": "And what is its population?"}
    ],
    text={
        "format": {
            "type": "json_object" # Enforces JSON Mode on the conversation tail
        }
    }
)

print(response.output_text)

# second example

import json
from openai import OpenAI

# Initializes client using the OPENAI_API_KEY environment variable
client = OpenAI()

try:
    response = client.responses.create(
        model="gpt-4o",
        # Use input instead of messages for standalone text generation prompts
        input="Give me a list of 3 fruits and their colors. Respond with a JSON object.",
        # The Responses API uses text.format instead of response_format
        text={
            "format": {
                "type": "json_object"
            }
        }
    )

    # Use the output_text helper to grab the raw string content directly
    raw_json = response.output_text
    print("Raw Output:\n", raw_json)

    # Parse and work with your data
    data = json.loads(raw_json)
    print("\nParsed Python Dict:", data)

except Exception as e:
    print(f"An error occurred: {e}")

