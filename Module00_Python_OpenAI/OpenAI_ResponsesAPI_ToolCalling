# Shared tool specification array
my_tools = [
    {
        "type": "function",
        "function": {
            "name": "get_weather",
            "description": "Get current weather conditions for a location",
            "parameters": {
                "type": "object",
                "properties": {
                    "location": {"type": "string", "description": "City name"}
                },
                "required": ["location"]
            }
        }
    }
]

from openai import OpenAI
client = OpenAI()

# 1. Initialize our conversation history
conversation_history = [
    {"role": "user", "content": "What's the weather like in Paris?"}
]

response = client.responses.create(
    model="gpt-4o",
    input=conversation_history,
    tools=my_tools
)

# A temporary list to collect tool outputs before calling the LLM again
tool_outputs = []

# Step 2: Loop through the output items to find tool calls
for tool_call in response.output:
    if tool_call.type == "function_call":
        print(f"Model wants to call: {tool_call.name}")
        
        # Step 3: Run your local code execution
        tool_result = "{\"status\": \"Sunny\", \"temp\": \"22C\"}"
        
        # Step 4: Keep track of this tool_call item and its corresponding output
        tool_outputs.append(tool_call)
        tool_outputs.append({
            "type": "function_call_output",
            "call_id": tool_call.call_id,
            "output": tool_result
        })

# Step 5: If tools were called, extend the history and make a SINGLE call outside the loop
if tool_outputs:
    conversation_history.extend(tool_outputs)
    
    final_response = client.responses.create(
        model="gpt-4o",
        input=conversation_history
    )
    print(final_response.output_text)



# second example

from openai import OpenAI
import json

client = OpenAI()

# 1. Define a list of callable tools for the model
tools = [
    {
        "type": "function",
        "name": "get_horoscope",
        "description": "Get today's horoscope for an astrological sign.",
        "parameters": {
            "type": "object",
            "properties": {
                "sign": {
                    "type": "string",
                    "description": "An astrological sign like Taurus or Aquarius",
                },
            },
            "required": ["sign"],
        },
    },
]

def get_horoscope(sign):
    return f"{sign}: Next Tuesday you will befriend a baby otter."

# Create a running input list we will add to over time
input_list = [
    {"role": "user", "content": "What is my horoscope? I am an Aquarius."}
]

# 2. Prompt the model with tools defined
response = client.responses.create(
    model="gpt-5.4-nano",
    tools=tools,
    input=input_list,
)

# Save function call outputs for subsequent requests
input_list += response.output

def call_function(name, args):
    # if name == "get_weather":
    #     return get_weather(**args)
    if name == "get_horoscope":
        return get_horoscope(**args)

for tool_call in response.output:
    if tool_call.type == "function_call":
        if tool_call.name == "get_horoscope":
            # 3. Execute the function logic for get_horoscope
            args = json.loads(tool_call.arguments)
            result = call_function(tool_call.name, args)
            
            # 4. Provide function call results to the model
            input_list.append({
                "type": "function_call_output",
                "call_id": tool_call.call_id,
                "output": str(result)
            })

print("Final input:")
print(input_list)

response = client.responses.create(
    model="gpt-5.4-nano",
    instructions="Respond only with a horoscope generated by a tool.",
    tools=tools,
    input=input_list,
)

# 5. The model should be able to give a response!
print("Final output:")
print(response.model_dump_json(indent=2))
print("\n" + response.output_text)
